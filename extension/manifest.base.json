{
  "manifest_version": 3,
  "name": "Open Transfer Manager",
  "short_name": "OTM",
  "version": "0.1.0",
  "description": "Send downloads and videos to Open Transfer Manager: faster multi-connection downloads and video from 1000+ sites.",
  "homepage_url": "https://github.com/OthmenBedoui/open-transfer-manager",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Transfer Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "cookies",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"]
}
